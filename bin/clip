#!/bin/sh
set -eu

room="${CLIP_ROOM:-${1:-}}"
op="${2:-}"

if [ -z "$room" ]; then
  echo "usage: clip ROOM_URL [read|write|clear]" >&2
  exit 2
fi

case "$room" in
  *'?k='*)
    base=${room%%\?*}
    query=${room#*\?}
    key=${query#*k=}
    key=${key%%&*}
    endpoint="${base%/}/api/clip?k=$key"
    ;;
  */api/clip*) endpoint=$room ;;
  *)
    echo "clip: ROOM_URL needs a ?k= room key" >&2
    exit 2
    ;;
esac

if [ "$op" = "clear" ]; then
  curl -fsS -X DELETE "$endpoint"
elif [ "$op" = "write" ] || { [ -z "$op" ] && [ ! -t 0 ]; }; then
  curl -fsS -X PUT -H 'content-type: text/plain' --data-binary @- "$endpoint" >/dev/null
else
  curl -fsS "$endpoint"
fi
